/**
 * Cloudflare Workers Static Assets config
 *
 * Vite 5 build → dist/ → Workers Static Assets serve.
 * `not_found_handling: single-page-application` → React Router için 404'leri index.html'e fallback.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dent-route",
  "compatibility_date": "2024-12-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}

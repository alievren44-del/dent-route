# ─── Supabase ─────────────────────────────────────────
# Public anon key — frontend tarafından kullanılır (client-safe)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example

# Service role key — sadece bootstrap script + Edge Function tarafı
# UYARI: Bu key client-side koda EKLENMEMELİDİR
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example

# ─── Mapbox ───────────────────────────────────────────
# Public token — harita render için frontend kullanır
VITE_MAPBOX_PUBLIC_TOKEN=pk.example

# Secret token — Edge Function üzerinden çağrılır (server-side)
MAPBOX_SECRET_TOKEN=sk.example

# ─── Google Places ────────────────────────────────────
# Server-only key — Edge Function proxy kullanır
GOOGLE_PLACES_API_KEY=AIzaExample

# ─── MapTiler (opsiyonel, offline tile pack) ──────────
VITE_MAPTILER_KEY=

# ─── Custom CRM (custom_rest adapter modu için) ───────
# Sadece config.crm.type === 'custom_rest' ise gerekli
CUSTOM_CRM_TOKEN=

# ─── Environment ──────────────────────────────────────
NODE_ENV=development

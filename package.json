{
  "name": "saha-app",
  "version": "0.1.0",
  "description": "Field sales automation PWA — vertical-agnostic, white-label SaaS-ready",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-bundle.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 25",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"verticals/**/*.json\" \"config/**/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "saha:bootstrap": "tsx scripts/saha-bootstrap.ts",
    "saha:create-admin": "tsx scripts/bootstrap-admin.ts",
    "saha:check-setup": "tsx scripts/check-setup.ts",
    "saha:validate-verticals": "tsx scripts/validate-verticals.ts",
    "saha:import-sivas": "tsx scripts/import-sivas-legacy.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:push": "supabase db push",
    "check:duplicates": "tsx scripts/check-duplicates.ts",
    "saha:check-migrations": "tsx scripts/check-saha-migrations.ts",
    "db:local-reset": "tsx scripts/local-supabase-reset.ts",
    "db:local-dump-baseline": "supabase db dump --linked --schema public -f supabase/local/parla-schema-baseline.sql",
    "build:native": "cross-env NODE_ENV=production VITE_BUILD_TARGET=native vite build --mode production",
    "cap:sync": "npm run build:native && npx cap sync",
    "cap:android": "npm run build:native && npx cap sync android && npx cap open android",
    "cap:android:build": "npm run build:native && npx cap sync android && cd android && ./gradlew assembleRelease",
    "prepare": "echo 'skip husky in CI'"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-updater": "^8.49.1",
    "@hookform/resolvers": "^3.6.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/query-async-storage-persister": "^5.51.0",
    "@tanstack/react-query": "^5.51.0",
    "@tanstack/react-query-persist-client": "^5.51.0",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.395.0",
    "mapbox-gl": "^3.5.0",
    "modern-screenshot": "^4.7.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.0",
    "react-router-dom": "^6.24.0",
    "recharts": "^2.15.4",
    "sonner": "^1.5.0",
    "workbox-window": "^7.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/mapbox-gl": "^3.4.0",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.0",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.38",
    "prettier": "^3.3.0",
    "supabase": "^2.101.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^1.6.0"
  }
}
